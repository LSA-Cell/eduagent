# ---------- 全局 ----------
APP_ENV=dev
LOG_LEVEL=INFO

# ---------- PostgreSQL / Redis / MinIO ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=eduagent
POSTGRES_USER=eduagent
POSTGRES_PASSWORD=change_me_postgres
DATABASE_URL=postgresql+asyncpg://eduagent:change_me_postgres@postgres:5432/eduagent

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_USE_SSL=false
MINIO_ACCESS_KEY=eduagent_minio
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET_UPLOADS=eduagent-uploads
MINIO_BUCKET_GENERATED=eduagent-generated
MINIO_BUCKET_TEMPLATES=eduagent-templates
MINIO_USE_SSL=false

# ---------- 安全 ----------
JWT_SECRET=change_me_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# AES-256-GCM 主密钥（32 字节 base64），轮换周期 90 天
KEY_ENCRYPTION_MASTER_KEY=change_me_base64_32bytes_master_key

# ---------- 服务间地址 ----------
BFF_BASE_URL=http://bff:8000
INFERENCE_GATEWAY_URL=http://gateway:8001
AGENT_ORCHESTRATOR_URL=http://agent:8002
MULTIMODAL_URL=http://multimodal:8003
API_PROXY_URL=http://proxy:8004
DOCGEN_URL=http://docgen:8005
BILLING_URL=http://billing:8006
INTERNAL_SERVICE_TOKEN=change_me_internal_service_token

# ---------- Billing（会员订阅与支付，docs/billing/spec.md） ----------
# 支付渠道 webhook 验签密钥（JSON）：channel -> HMAC-SHA256 secret。
# 未配置 secret 的渠道回调一律 503 fail-closed；mock 渠道仅供 dev/test 全链路验证。
BILLING_WEBHOOK_SECRETS={"mock": "change_me_mock_webhook_secret"}

# ---------- 推理网关 ----------
# 自有模型路由表（JSON）：model 名 -> vLLM 实例列表
VLLM_ROUTES={"edu-general-14b": ["http://vllm-general:8100"], "edu-math-7b": ["http://vllm-math:8101"]}
MODEL_HEALTH_TTL_SECONDS=30
FAILOVER_ENABLED=true

# ---------- 平台级统一推理（兜底通道：用户未绑定自有 Key 时由平台代付） ----------
# 三项必须同时填写；PLATFORM_LLM_PROVIDER 留空 = 关闭兜底（未绑 Key 的用户会收到 404 引导绑 Key）
# PLATFORM_LLM_PROVIDER=moonshot        # 可选：moonshot / openai / deepseek / claude / gemini
# PLATFORM_LLM_API_KEY=sk-xxxxxxxx      # 厂商控制台申请的真实 Key（Moonshot: platform.moonshot.cn）
# PLATFORM_LLM_MODEL=kimi-k2.5          # 真实型号名，见下方对照：
#   moonshot → kimi-k2.5 / kimi-k2.6 / kimi-k3 / moonshot-v1-8k（便宜）
#   deepseek → deepseek-chat（便宜，推荐起步）/ deepseek-reasoner（推理强，贵）
#   openai   → gpt-4o-mini / gpt-4o
#   claude   → claude-sonnet-4-5 / claude-haiku-4-5
#   gemini   → gemini-2.0-flash / gemini-2.5-pro

# ---------- 第三方搜索 ----------
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_API_KEY=

# ---------- 限流（RPM） ----------
RATE_LIMIT_FREE=20
RATE_LIMIT_PAID=60
RATE_LIMIT_TEACHER=100

# ---------- 游客登录（设备 ID 换令牌，不强制注册） ----------
GUEST_LOGIN_ENABLED=true

# ---------- 登录安全（BFF） ----------
LOGIN_MAX_FAILURES=5          # 连续失败后锁定账号
LOGIN_LOCK_MINUTES=15         # 锁定时长
LOGIN_CAPTCHA_THRESHOLD=3     # 连续失败后要求图形验证码
CAPTCHA_EXPIRE_MINUTES=5
SINGLE_DEVICE_LOGIN=false     # true=新登录踢掉同账号其他设备

# ---------- 短信验证码（BFF） ----------
# log=仅写日志（仅 dev/test，生产启动拒绝）；webhook=POST 到 SMS_WEBHOOK_URL
SMS_PROVIDER=log
SMS_WEBHOOK_URL=
SMS_CODE_EXPIRE_MINUTES=5
SMS_CODE_LENGTH=6
SMS_SEND_INTERVAL_SECONDS=60
SMS_DAILY_LIMIT=10
SMS_MAX_VERIFY_ATTEMPTS=5
SMS_VERIFY_REGISTER=true      # 注册必须短信验证

# ---------- 第三方登录（未配置时对应端点 503 fail-closed） ----------
WECHAT_APP_ID=
WECHAT_APP_SECRET=
APPLE_CLIENT_ID=              # iOS Bundle ID（identity_token 的 aud）

# ---------- CORS（BFF，逗号分隔；生产必须显式收敛到 App 域名） ----------
CORS_ORIGINS=*

# ---------- vLLM 自有模型（gpu profile） ----------
VLLM_GENERAL_MODEL=/models/edu-general-14b
VLLM_MATH_MODEL=/models/edu-math-7b
VLLM_MODELS_DIR=./infra/models
